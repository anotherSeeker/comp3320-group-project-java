void PrecomputeTwiddleFactorsAndInputIndices()
{
	ivec2 id = ivec2(gl_GlobalInvocationID.xy);
	uint stage = gl_GlobalInvocationID.x;
	uint coord = gl_GlobalInvocationID.y;

	uint N = uint(texSize);
	float mult = 2*PI/N;
	uint b = N >> (stage + 1);

	//integer division and rounding???? I think???? I haven no idea why
	uint i = (2*b*(coord/b) + (coord % b)) % N;
	float value = -mult * ((coord/b) * b);

	vec2 twiddle = vec2(cos(value), sin(value));

	imageStore(butterflyTex, id, vec4(twiddle.x, twiddle.y, i, i+b));
	imageStore(butterflyTex, ivec2(stage, coord+N/2), vec4(-twiddle.x, -twiddle.y, i, i+b) );
}

void main()
{
	PrecomputeTwiddleFactorsAndInputIndices();
}