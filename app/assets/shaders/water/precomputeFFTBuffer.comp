#version 430 core
#define PI 3.14159265359

layout(local_size_x = 1, local_size_y = 8, local_size_z = 1) in;

layout(rgba32f, binding = 0) uniform image2D butterflyTex;

uniform int texSize;

//generating our "butterfly texture" for the fft based primarily on GPGPU FFT paper

//bit reversal based on the size of the input number
uint reverseBits(uint n)
{
    uint rev = 0;
	//we use this to restrict the size of our swap or a 1 would become 2^32 where we want a 1 to become 2^7 for a texture size of 2^8
	uint size = texSize;

    while (size > 0)
    {
		//change our "working index", by shifting left
        rev = rev << 1; 

		//bitwise and so if the first bit of n == 1 then we xor with one to make our first bit of the output 1 as we've just shifted left so there has to be a zero
        if ((n & 1) == 1)
            rev = rev ^ 1;

        n = n >> 1;
		size = size >> 1;
    }

    return rev;
}

vec2 cExp(vec2 a)
{
    return vec2(cos(a.y), sin(a.y)) * exp(a.x);
}

