#version 430 core
#define PI 3.14159265359

layout(local_size_x = 1, local_size_y = 8, local_size_z = 1) in;

layout(rgba32f, binding = 0) uniform image2D butterflyTex;

uniform int texSize;

uint reverseBits(uint n, uint bitCount)
{
   return bitfieldReverse(n) >> (32u - bitCount);
}

vec2 cExp(vec2 a)
{
    return vec2(cos(a.y), sin(a.y)) * exp(a.x);
}

void PrecomputeTwiddleFactorsAndInputIndices()
{
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    uint stage = gl_GlobalInvocationID.x;
    uint outIndex = gl_GlobalInvocationID.y;
    uint N = uint(texSize);

    uint span = 1u << stage;
    uint blockSize = span << 1u;
    uint j = outIndex % span;
    uint groupStart = (outIndex / blockSize) * blockSize;
    uint input0 = groupStart + j;
    uint input1 = input0 + span;

    // DIT starts from bit-reversed input, only for the first stage.
    if (stage == 0u)
    {
        uint bitCount = uint(round(log2(float(N))));
        input0 = reverseBits(input0, bitCount);
        input1 = reverseBits(input1, bitCount);
    }

    // Store exp(-i*theta); IFFT.comp conjugates this to exp(+i*theta).
    float angle = 2.0 * PI * float(j) / float(blockSize);
    vec2 twiddle = vec2(cos(angle), -sin(angle));

    // The upper output of a DIT butterfly uses -W.
    if ((outIndex % blockSize) >= span)
        twiddle = -twiddle;

    imageStore(
        butterflyTex,
        id,
        vec4(twiddle, float(input0), float(input1))
    );
}

void main()
{
	PrecomputeTwiddleFactorsAndInputIndices();
}