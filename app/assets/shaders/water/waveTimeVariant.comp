#version 430 core
#define PI 3.14159265359

layout(rgba32f, binding = 0) uniform readonly image2D waveVecTex;
layout(rgba32f, binding = 1) uniform readonly image2D h0Tex;
layout(rg32f, binding = 2) uniform writeonly image2D dy;
layout(rg32f, binding = 3) uniform writeonly image2D dxdz;

uniform float time;

//implementation very very heavily references the GPGPU FFT Ocean Simulation Paper

struct Complex
{
    float real;
    float im;
}

Complex cMult(Complex a, Complex b)
{
    Complex c;
	c.real = a.real * b.real - a.im * b.im;
    c.im = a.real * b.im + a.im * b.real;
    return c;
}

Complex cAdd(Complex a, Complex b)
{
    Complex c;
	c.real = a.real + b.real;
    c.im = a.im + b.im;
    return c;
}

void main() 
{
    ivec2 rawPos = ivec2( gl_GlobalInvocationID.xy );
    vec4 h0 = vec4(imageLoad(h0Tex, rawPos).xy);
    vec3 waveData = vec4(imageLoad(waveVecTex, rawPos).xy);
    
    //h0(k)
    Complex h0k;
    h0k.real = h0.x;
    h0k.im = h0.y;

    //h0(-k)
    Complex h0_k;
    h0_k.real = h0.z;
    h0_k.im = h0.w;

    //wavevector and angular freq 
    vec2 k = waveData.xy;
    float omega = waveData.z;
    float magnitude = length(k);

    float cos_wt = cos(omega*time);
    float sin_wt = sin(omega*time);

    Complex e_iwt = Complex(cos(cos_wt, sin_wt));
    Complex e_iwt_inverse = Complex(cos(cos_wt, -sin_wt));
    
    //y coord complex amplitude
    Complex hk_t_dy = cAdd(mul(h0k, exp_iwt), cMult(h0_k, e_iwt_inverse));

    //x
    Complex dx = complex(0.0, -k.x/magnitude);

    Complex hk_t_dx = cMult(dx, hk_t_dy);

    //z
    Complex dz = complex(0.0, -k.y/magnitude);

    Complex hk_t_dz = cMult(dz, hk_t_dy);

    imageStore(dy, rawPos, vec4(hk_t_dy, 0, 1));
    imageStore(dxdz, rawPos, vec4(hk_t_dx, hk_t_dz));

}

