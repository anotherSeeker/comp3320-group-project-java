#version 430 core
#define PI 3.14159265359

#define gravity_g 9.81
#define waterDensity_rho 1000.0
#define surfaceTensionCoefficient_sigma 0.074
#define gamma 3.3 //gamma: the "peak enhancement factor", from the JONSWAP spectrum, do not ask me I am not an oceanographer

#define doCapillaryWaves true

//todo: input patch length as a variable along with the configurable ones above, F, U & H

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(rg32f, binding = 0) uniform readonly image2D gaussianData;
layout(rgba32f, binding = 1) uniform image2D waveVecTex;
layout(rg32f, binding = 2) uniform image2D h0Tex;

uniform float patchLength;
uniform int textureSize;
uniform float fetch_F;
uniform float depth_H;
uniform float windSpeed_U;

//donelan-banner spreading function
float doDirectionalSpread(float omega, float omegaPeak, float theta)
{
    float D = 0;
    float beta = 0;
    float baseOnPeak = omega/omegaPeak;

    if (baseOnPeak < 0.95)
    {
        beta = 2.61 * pow(baseOnPeak, 1.3);
    }
    else if (baseOnPeak >= 0.95 && baseOnPeak < 1.6)
    {
        beta = 2.28 * pow(baseOnPeak, -1.3);
    }
    else
    {
        float epsilon = -0.4 + 0.8393 * exp(-0.567*log(baseOnPeak*baseOnPeak));
        beta = pow(10, epsilon);
    }

    float sech = 1/cosh(beta*theta);
    D = ( beta / (2*tanh(beta*PI)) ) * sech * sech;

    return D;
}

float waveVectorMagnitude_k(float kx, float kz)
{
    return sqrt(kx*kx + kz*kz);
}

//calculate parameters
float dispersionRelation_omega(float kx, float kz, float magnitude)
{
    float aFreq = 0.0f;

    // #ifdef doCapillaryWaves
    //     //includes variables for capillary waves? might look better?
    //     aFreq = sqrt((gravity_g * magnitude_k + (surfaceTensionCoefficient_sigma/waterDensity_rho) * pow(magnitude_k, 3)) * tanh(magnitude_k * depth_H));
    //     return aFreq;
    // #endif

    aFreq = sqrt(gravity_g * magnitude * tanh(magnitude * depth_H));
    return aFreq;
}

float omegaDerivative(float magnitude, float omega)
{
	float th = tanh(min(magnitude * depth_H, 20));
	float ch = cosh(magnitude * depth_H);
	return gravity_g * (depth_H * magnitude / (ch * ch) + th) / omega / 2;
}

float dispersionDerivative()
{
    return 0.0;
}

//angle of the wave as compared to the wind direction
float windWaveDirection_Theta(float kx, float kz)
{
    //theta = arctan(kz/kx)
    return atan(kz / kx);
}

 //I believe that this is the surface tension parameter and that jonswap uses a slightly different one for some reason?
float sigma_J(float peakFrequency, float waveFrequency)
{
    float alpha = 0.09;
    if (peakFrequency >= waveFrequency)
        alpha = 0.07;

    return alpha;
}

//JONSWAP amplitude
float amplitudeAlpha_J()
{
    //as far as I understand 0.076 is the real surface tension of water? perhaps it differs in ocean conditions? again not an oceanographer
    return 0.076 * pow((windSpeed_U*windSpeed_U)/(fetch_F*gravity_g), 0.22);
}

    //e^[stuff] part of the jonswap equation you might not have heard but I'm not an oceanographer
float exponent_r_J(float omegaPeak, float omega, float sigma)
{
    float a = pow(omega - omegaPeak, 2);
    float b = 2*sigma*sigma*omegaPeak*omegaPeak;

    float c = -(a/b);
    float r = exp(c);

    return r;
}

//peak angular frequency
float omega_p_J()
{
    return (22 * ( pow(gravity_g,2) / (windSpeed_U * fetch_F) ) );
}

//S(omega) wave spectrum calculation
float doJONSWAP(float omega, float omegaPeak)
{
    //amplitude of this wave
    float alpha = amplitudeAlpha_J();
    //I believe this is the surface tension term?
    float sigma = sigma_J(omegaPeak, omega);
    //exponent r
    float r = exponent_r_J(omegaPeak, omega, sigma);


    //the actual equation bits
    float a = (alpha*gravity_g*gravity_g)/pow(omega, 5);

    float b = (-5/4) * pow((omegaPeak/omega), 4);
    float c = exp(b);

    float S_jonswap = a*c*pow(gamma, r);

    return S_jonswap;
}

//the Christopher Horvath paper recommends this for correcting jonswap at shallow depths
float tmaCorrection(float omega)
{
    float omega_h = omega * sqrt(depth_H/gravity_g); 

    if (omega_h <= 1)
    {
        return 0.5*omega_h*omega_h;
    }
    else
    {
        return 1 - 0.5 * (2-omega_h) * (2-omega_h);
    }
}

void main() 
{
    ivec2 rawPos = ivec2( gl_GlobalInvocationID.xy );
    
    int texSize = textureSize;
    float texSizef = float(texSize);

    //ok we were doing it wrong I'm pretty sure after re reading our sources pretty confident we should be calculating kx, kz like this instead
        //always working with powers of two for image sizing
        //float halfSize = (texSizef-1)/2;
        //float scale = 0.25;
        //mapping to series of radial direction vectors, rotation of the map shouldn't matter at all

    //pretty sure this is the correct wave vectors now?

    //number of points in x dir and y dir cause square tex
    float N = texSize;
    //physical size of the patch, we should be passing this in instead
    float L = patchLength;

    float deltaK = 2 * PI / L;

    float n = (rawPos.x - (N/2.0) );
    float m = (rawPos.y - (N/2.0) );

    float kx = (rawPos.x - (N/2.0)) * deltaK;
    float kz = (rawPos.y - (N/2.0)) * deltaK;
    float kxmin = -kx;
    float kzmin = -kz;

    vec2 noise_xi = vec2(imageLoad(gaussianData, rawPos).xy);

    float magnitude_k = waveVectorMagnitude_k(kx,kz);
    float omega = dispersionRelation_omega(kx, kz, magnitude_k);
    float omegaMin = dispersionRelation_omega(kxmin, kzmin, magnitude_k);

    //peak frequency of the wave spectrum
    float omegaPeak = omega_p_J();

    float theta = windWaveDirection_Theta(kx, kz);
    float thetaMin = windWaveDirection_Theta(kxmin, kzmin);

    float S = doJONSWAP(omega, omegaPeak);
    float D = doDirectionalSpread(omega, omegaPeak, theta);
    float tma = tmaCorrection(omega);

    float SMin = doJONSWAP(omegaMin, omegaPeak);
    float DMin = doDirectionalSpread(omegaMin, omegaPeak, thetaMin);
    float tmaMin = tmaCorrection(omegaMin);

    //we missed a 2 in here
    float h0 = (1.0/(sqrt(2.0))) * sqrt(2*S*D*tma*deltaK*deltaK);
    float h0_real    = h0 * noise_xi.x ;
    float h0_complex = h0 * noise_xi.y;

    //we also need h0(-k) for the fourier transform
    float h0M = (1.0/(sqrt(2.0))) * sqrt(2*SMin*DMin*tmaMin*deltaK*deltaK);
    float h0M_real    = h0M * noise_xi.x;
    float h0M_complex = h0M * noise_xi.y;

    imageStore( waveVecTex, rawPos, vec4(kx,kz,omega,1/waveVectorMagnitude_k(kx,kz)) );
    //storing h0(k) and h0(-k)
    imageStore( h0Tex, rawPos, vec4(h0_real,h0_complex,h0M_real,h0M_complex) );
}

