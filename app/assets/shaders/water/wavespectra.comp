#version 430 core
#define PI 3.14159265359

#define gravity_g 9.81
#define waterDensity_rho 1000.0
#define surfaceTensionCoefficient_sigma 0.074
#define depth_H 50.0 //H or sometimes D: depth of the water, has to be just one depth or we'd need to recalculate a new map for every part of the ocean which is kinda infeasible unless I'm horrifically mistaken
#define windSpeed_U 20.0 //U: windspeed, I believe meters per second?
#define fetch_F 2000.0 //F: distance to shore from the direction that the wind is blowing from
#define gamma 3.3 //gamma: the "peak enhancement factor", from the JONSWAP spectrum, do not ask me I am not an oceanographer

//#define doCapillaryWaves true

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(rg32f, binding = 0) uniform readonly image2D gaussianData;
layout(rgba32f, binding = 1) uniform writeonly image2D waveVecTex;
layout(rgba32f, binding = 2) uniform writeonly image2D h0Tex;

//D(omega, theta) controls the strength of waves based on the direction relative to the direction of travel
float doDirectionalSpread(float omega, float theta)
{
    //decide which spread functions we want to use
    float spread = 0;

    //for now just using the "positive cosine squared" spreading that tessendorf used   
    if (theta > (-PI/2) && theta < (PI/2))
    {
        spread = (2.0/PI) * pow(cos(theta), 2);
    }

    return spread;
}

float waveVectorMagnitude_k(float kx, float ky)
{
    return sqrt(kx*kx + ky*ky);
}

//calculate parameters
float dispersionRelation_omega(float kx, float ky)
{
    float aFreq = 0.0f;
    float magnitude_k = waveVectorMagnitude_k(kx,ky);

    // #ifdef doCapillaryWaves
    //     //includes variables for capillary waves? might look better?
    //     aFreq = sqrt((gravity_g * magnitude_k + (surfaceTensionCoefficient_sigma/waterDensity_rho) * pow(magnitude_k, 3)) * tanh(magnitude_k * depth_H));
    //     return aFreq;
    // #endif

    aFreq = sqrt(gravity_g * magnitude_k * tanh(magnitude_k * depth_H));
    return aFreq;
}

//angle of the wave as compared to the wind direction
float windWaveDirection_Theta(float kx, float ky)
{
    //theta = arctan(ky/kx)
    return atan(ky / kx);
}

 //I believe that this is the surface tension parameter and that jonswap uses a slightly different one for some reason?
float sigma_J(float peakFrequency, float waveFrequency)
{
    float alpha = 0.09;
    if (peakFrequency >= waveFrequency)
        alpha = 0.07;

    return alpha;
}

//JONSWAP amplitude
float amplitudeAlpha_J()
{
    //as far as I understand 0.076 is the real surface tension of water? perhaps it differs in ocean conditions? again not an oceanographer
    return 0.076 * pow((windSpeed_U*windSpeed_U)/(fetch_F*gravity_g), 0.22);
}

    //e^[stuff] part of the jonswap equation you might not have heard but I'm not an oceanographer
float exponent_r_J(float omegaPeak, float omega, float sigma)
{
    float a = pow(omega - omegaPeak, 2);
    float b = 2*sigma*sigma*omegaPeak*omegaPeak;

    float c = -(a/b);
    float r = exp(c);

    return r;
}

//peak angular frequency
float omega_p_J()
{
    return (22 * ( pow(gravity_g,2) / (windSpeed_U * fetch_F) ) );
}

//S(omega) wave spectrum calculation
float doJONSWAP(float omega)
{
    //peak frequency of the wave spectrum
    float omegaPeak = omega_p_J();
    //amplitude of this wave
    float alpha = amplitudeAlpha_J();
    //I believe this is the surface tension term?
    float sigma = sigma_J(omegaPeak, omega);
    //exponent r
    float r = exponent_r_J(omegaPeak, omega, sigma);


    //the actual equation bits
    float a = (alpha*gravity_g*gravity_g)/pow(omega, 5);

    float b = (-5/4) * pow((omegaPeak/omega), 4);
    float c = exp(b);

    float S_jonswap = a*c*pow(gamma, r);

    return S_jonswap;
}

void main() 
{
    ivec2 rawPos = ivec2( gl_GlobalInvocationID.xy );
    
    int texSize = imageSize(gaussianData).x;
    float texSizef = float(texSize);

    //always working with powers of two for image sizing
    float halfSize = (texSizef-1.0)/2.0;
    //float scale = 0.25;
    //mapping to series of radial direction vectors, rotation of the map shouldn't matter at all
    float kx = (rawPos.x - halfSize);
    float ky = (rawPos.y - halfSize);

    ivec2 wavevector_k = ivec2(kx,ky);
    vec2 noise_xi = vec2(imageLoad(gaussianData, rawPos).xy);

    float omega = dispersionRelation_omega(kx, ky);

    float theta = windWaveDirection_Theta(kx,ky);

    float S = doJONSWAP(omega);
    float D = doDirectionalSpread(omega, theta);

    float h0 = (1.0/(sqrt(2))) * sqrt(S*D);
    float h0_real    = h0 * noise_xi.x;
    float h0_complex = h0 * noise_xi.y;

    imageStore( waveVecTex, rawPos, vec4(kx,ky,omega,1) );
    imageStore( h0Tex, rawPos, vec4(h0_real,h0_complex,0,1) );
}

