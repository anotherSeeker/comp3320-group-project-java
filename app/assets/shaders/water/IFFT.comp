#version 430 core
#define PI 3.14159265359

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

//"butterfly texture"
layout(rgba32f, binding = 0) uniform image2D ButterflyTex;

layout(rg32f, binding = 1) uniform image2D buffer0;
layout(rg32f, binding = 2) uniform image2D buffer1;

uniform int H_or_V;
uniform int size;
uniform int pingpong;
uniform int stage;


vec2 cMult(vec2 a, vec2 b)
{
    return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

vec2 cAdd(vec2 a, vec2 b)
{
    return vec2(a.x + b.x, a.y + b.y);
}

vec2 cExp(vec2 a)
{
    return vec2(cos(a.y), sin(a.y)) * exp(a.x);
}

void Permute()
{
	ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
	vec2 value = vec2(0,0);

	value = imageLoad(buffer0, texelCoord).xy; 

	//inverts if x + y is odd
	value = vec2( (value) * (1.0 - 2.0 * mod(float((texelCoord.x + texelCoord.y)), 2)));

	imageStore(buffer0, texelCoord, vec4(value, 0, 1) );
}

void horizStep()
{
    ivec2 texelCoord = ivec2( gl_GlobalInvocationID.xy );
    vec4 butterfly = imageLoad(ButterflyTex, ivec2(stage, texelCoord.x));
	
	vec2 twiddleFactors = vec2(butterfly.rg);
	ivec2 inputIndices = ivec2(butterfly.ba);

	if (pingpong == 1)
	{
		vec2 out1 = vec2(	imageLoad(buffer0, ivec2(inputIndices.x, texelCoord.y)).xy 
							+ 
							cMult(	vec2(twiddleFactors.x, -twiddleFactors.y), //vec2(twiddleFactors.x, -twiddleFactors.y),
									vec2(imageLoad(buffer0, ivec2(inputIndices.y, texelCoord.y)).xy) 
								) 
						);

		imageStore(buffer1, texelCoord, vec4(out1.x, out1.y, 0, 1));
		//imageStore(buffer1, texelCoord, vec4(1, 1, 0, 0));
	}
	else
	{
		vec2 out0 = vec2(	imageLoad(buffer1, ivec2(inputIndices.x, texelCoord.y)).xy 
							+ 
							cMult(	vec2(twiddleFactors.x, -twiddleFactors.y), //vec2(twiddleFactors.x, -twiddleFactors.y),
									vec2(imageLoad(buffer1, ivec2(inputIndices.y, texelCoord.y)).xy) 
								) 
						);
		
		imageStore(buffer0, texelCoord, vec4(out0.x, out0.y, 0, 1));
		//imageStore(buffer0, texelCoord, vec4(1, 1, 0, 0));
	}
}

void vertStep()
{
	ivec2 texelCoord = ivec2( gl_GlobalInvocationID.xy );
    vec4 butterfly = imageLoad(ButterflyTex, ivec2(stage, texelCoord.y));

	vec2 twiddleFactors = vec2(butterfly.xy);
	ivec2 inputIndices = ivec2(butterfly.zw);


	if (pingpong == 1)
	{
		vec2 out1 = vec2(	imageLoad(buffer0, ivec2(texelCoord.x, inputIndices.x)).xy 
							+ 
							cMult(	vec2(twiddleFactors.x, -twiddleFactors.y), //vec2(twiddleFactors.x, -twiddleFactors.y),
									imageLoad(buffer0, ivec2(texelCoord.x, inputIndices.y)).xy 
							) 
						);			
		
		imageStore(buffer1, texelCoord, vec4(out1.x, out1.y, 0, 1));
		//imageStore(buffer1, texelCoord, vec4(1, 1, 0, 0));
	}
	else
	{
		vec2 out0 = vec2(	imageLoad(buffer1, ivec2(texelCoord.x, inputIndices.x)).xy 
							+ 
							cMult(	vec2(twiddleFactors.x, -twiddleFactors.y), //vec2(twiddleFactors.x, -twiddleFactors.y),
									imageLoad(buffer1, ivec2(texelCoord.x, inputIndices.y)).xy) 
						);

		imageStore(buffer0, texelCoord, vec4(out0.x, out0.y, 0, 1));
		//imageStore(buffer0, texelCoord, vec4(1, 1, 0, 0));
	}
}

void main()
{
    if (H_or_V == 0)
		horizStep();
		//horizStepAlt();
	else if (H_or_V == 1)
		vertStep();
		//vertStepAlt();
	else
		Permute();

}