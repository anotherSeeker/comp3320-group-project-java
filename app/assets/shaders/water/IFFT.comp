#version 430 core
#define PI 3.14159265359

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

//"butterfly texture"
layout(rgba32f, binding = 0) uniform image2D ButterflyTex;

layout(rg32f, binding = 1) uniform image2D buffer0;
layout(rg32f, binding = 2) uniform image2D buffer1;

uniform int H_or_V;
uniform int size;
uniform int pingpong;
uniform int stage;


vec2 cMult(vec2 a, vec2 b)
{
    return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

vec2 cExp(vec2 a)
{
    return vec2(cos(a.y), sin(a.y)) * exp(a.x);
}

void horizStep()
{
    ivec2 invocID = ivec2( gl_GlobalInvocationID.xy );
    vec4 butterfly = imageLoad(ButterflyTex, ivec2(stage, invocID.x));
	
	vec2 twiddleFactors = vec2(butterfly.xy);
	ivec2 inputIndices = ivec2(butterfly.zw);

	if (pingpong == 1)
	{
		vec2 out1 = vec2(	imageLoad(buffer0, ivec2(inputIndices.x, invocID.y)).xy 
							+ 
							cMult(	vec2(twiddleFactors.x, -twiddleFactors.y), 
									vec2(imageLoad(buffer0, ivec2(inputIndices.y, invocID.y)).xy) 
								) 
						);


		imageStore(buffer1, invocID, vec4(out1.x, out1.y, 0, 1));
		//imageStore(buffer1, invocID, vec4(1, 1, 0, 0));
	}
	else
	{
		vec2 out0 = vec2(	imageLoad(buffer1, ivec2(inputIndices.x, invocID.y)).xy 
							+ 
							cMult(	vec2(twiddleFactors.x, -twiddleFactors.y), 
									vec2(imageLoad(buffer1, ivec2(inputIndices.y, invocID.y)).xy) 
								) 
						);
		
		imageStore(buffer0, invocID, vec4(out0.x, out0.y, 0, 1));
		//imageStore(buffer0, invocID, vec4(1, 1, 0, 0));
	}
}

void vertStep()
{
	ivec2 invocID = ivec2( gl_GlobalInvocationID.xy );
    vec4 butterfly = imageLoad(ButterflyTex, ivec2(stage, invocID.y));

	vec2 twiddleFactors = vec2(butterfly.xy);
	ivec2 inputIndices = ivec2(butterfly.zw);


	if (pingpong == 1)
	{
		vec2 out1 = vec2(	imageLoad(buffer0, ivec2(invocID.x, inputIndices.x)).xy 
							+ 
							cMult(	vec2(twiddleFactors.x, -twiddleFactors.y), 
									imageLoad(buffer0, ivec2(invocID.x, inputIndices.y)).xy 
							) 
						);
		
		imageStore(buffer1, invocID, vec4(out1.x, out1.y, 0, 1));
		//imageStore(buffer1, invocID, vec4(1, 1, 0, 0));
	}
	else
	{
		vec2 out0 = vec2(	imageLoad(buffer1, ivec2(invocID.x, inputIndices.x)).xy 
							+ 
							cMult(	vec2(twiddleFactors.x, -twiddleFactors.y), 
									imageLoad(buffer1, ivec2(invocID.x, inputIndices.y)).xy) 
						);

		imageStore(buffer0, invocID, vec4(out0.x, out0.y, 0, 1));
		//imageStore(buffer0, invocID, vec4(1, 1, 0, 0));
	}
}

