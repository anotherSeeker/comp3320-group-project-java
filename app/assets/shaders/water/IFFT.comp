#version 430 core
#define PI 3.14159265359

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

//"butterfly texture"
layout(rgba32f, binding = 0) uniform image2D ButterflyTex;

layout(rgba32f, binding = 1) uniform image2D buffer0;
layout(rgba32f, binding = 2) uniform image2D buffer1;

uniform int H_or_V;
uniform float size;
uniform int pingpong;
uniform int stage;


vec2 cMult(vec2 a, vec2 b)
{
    return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

vec2 cExp(vec2 a)
{
    return vec2(cos(a.y), sin(a.y)) * exp(a.x);
}

vec2 horizStep()
{
    ivec2 invocID = ivec2( gl_GlobalInvocationID.xy );
    vec4 butterfly = imageLoad(ButterflyTex, invocID)//PrecomputedData[vec2(Step, id.x)];

	ivec2 inputsIndices = (ivec2)butterfly.zw;

    //imageLoad(buffer0, position);

	if (pingpong)
	{
		vec2 out1 = vec2(imageLoad(buffer0, vec2(inputsIndices.x, id.y)) + cMult(vec2(butterfly.x, -butterfly.y)), imageLoad(buffer0, vec2(inputsIndices.y, id.y)) );
		imageStore(buffer1, invocID, vec4(out1.x, out1.y, 0, 0));
	}
	else
	{
		vec2 out0 = vec2(imageLoad(buffer1, vec2(inputsIndices.x, id.y)) + cMult(vec2(butterfly.x, -butterfly.y)), imageLoad(buffer1, vec2(inputsIndices.y, id.y)) );
		imageStore(buffer0, invocID, vec4(out0.x, out0.y, 0, 0));
	}
}

vec2 vertStep()
{
	ivec2 invocID = ivec2( gl_GlobalInvocationID.xy );
    vec4 butterfly = imageLoad(ButterflyTex, invocID)//PrecomputedData[vec2(Step, id.x)];

	ivec2 inputsIndices = (ivec2)butterfly.zw;


	if (pingpong)
	{
		//Buffer1[id.xy] = Buffer0[uint2(id.x, inputsIndices.x)] + ComplexMult(float2(data.r, -data.g), Buffer0[uint2(id.x, inputsIndices.y)]);

		vec2 out1 = vec2(imageLoad(buffer0, vec2(id.x, inputsIndices.x)) + cMult( vec2(butterfly.x, -butterfly.y), imageLoad(buffer0, vec2(id.x, inputsIndices.y)) ) );
		imageStore(buffer1, invocID, vec4(out1.x, out1.y, 0, 0));
	}
	else
	{
		//Buffer0[id.xy] = Buffer1[uint2(id.x, inputsIndices.x)] + ComplexMult(float2(data.r, -data.g), Buffer1[uint2(id.x, inputsIndices.y)]);

		vec2 out0 = vec2(imageLoad(buffer1, vec2(id.x, inputsIndices.x)) + cMult( vec2(butterfly.x, -butterfly.y), imageLoad(buffer1, vec2(id.x, inputsIndices.y)) ) );
		imageStore(buffer0, invocID, vec4(out0.x, out0.y, 0, 0));
	}
}

void main()
{
    if (H_or_V == 0)
		horizStep();
	else
		vertStep();
}