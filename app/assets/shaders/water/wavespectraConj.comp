#version 430 core
#define PI 3.14159265359

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform int textureSize;
layout(rgba32f, binding = 0) uniform image2D h0Tex;

void main()
{
    ivec2 id = ivec2( gl_GlobalInvocationID.xy );
    
    //H0K[uint2((Size - id.x) % Size, (Size - id.y) % Size)];
    vec2 base = imageLoad(h0Tex, id).xy;
    vec2 minus = imageLoad(h0Tex, ivec2( mod(textureSize - id.x, textureSize), mod(textureSize - id.y, textureSize) ) ).xy;

    imageStore( h0Tex, id, vec4(base.x,base.y,minus.x,-minus.y) ); 
}