#version 430 core
#define PI 3.14159265359

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform int textureSize;
layout(rgba32f, binding = 0) uniform image2D h0Tex;

void main()
{
    ivec2 rawPos = ivec2( gl_GlobalInvocationID.xy );
    
    vec4 base = imageLoad(h0Tex, rawPos);
    vec4 minus = imageLoad(h0Tex, ivec2( mod(textureSize - rawPos.x, textureSize), mod(textureSize - rawPos.y, textureSize) ) );

    imageStore( h0Tex, rawPos, vec4(base.x,base.y,minus.x,-minus.y) ); //H0K[uint2((Size - id.x) % Size, (Size - id.y) % Size)];
}